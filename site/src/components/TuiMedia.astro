---
// A TUI recording or screenshot in two variants, <name>.light.<ext> and <name>.dark.<ext> (scripts/tui-media/build.mjs
// writes both into public/media/tui). Starlight sets data-theme on <html>; the CSS below shows the matching variant.
// `alt` describes what the picture shows; GIFs carry a key overlay at the bottom right, say so in `caption`.
interface Props {
	name: string;
	alt: string;
	ext?: 'gif' | 'png';
	caption?: string;
}
const { name, alt, ext = 'gif', caption } = Astro.props;
const src = (theme: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/media/tui/${name}.${theme}.${ext}`;
---

<figure class="tui-media not-content">
	<img class="only-light" src={src('light')} alt={alt} loading="lazy" decoding="async" />
	<img class="only-dark" src={src('dark')} alt={alt} loading="lazy" decoding="async" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.tui-media { margin: 1.5rem 0; }
	.tui-media img { display: block; width: 100%; height: auto; border: 1px solid var(--okf-rule, var(--sl-color-gray-5)); border-radius: 0.5rem; }
	.tui-media figcaption { margin-top: 0.5rem; font-size: 0.8125rem; color: var(--okf-ink-muted, var(--sl-color-gray-3)); }
	:global(:root[data-theme='dark']) .only-light, :global(:root:not([data-theme='dark'])) .only-dark { display: none; }
</style>
