--- a/handbook/assets/viz.html
+++ b/handbook/assets/viz.html
@@ -0,0 +1,34 @@
+<!doctype html><html><head><meta charset="utf-8">
+<title>OKF — handbook</title>
+<script src="https://unpkg.com/cytoscape@3.28.1/dist/cytoscape.min.js"></script>
+<script src="https://cdn.jsdelivr.net/npm/marked@12/marked.min.js"></script>
+<style>
+ body{margin:0;font:14px/1.5 system-ui,sans-serif;display:flex;height:100vh}
+ #g{flex:1;background:#0d1117}
+ #p{width:38%;max-width:560px;overflow:auto;padding:16px 22px;border-left:1px solid #30363d;background:#161b22;color:#c9d1d9}
+ #p h1,#p h2,#p h3{color:#e6edf3} #p a{color:#58a6ff} #p code,#p pre{background:#0d1117;border-radius:6px}
+ #p pre{padding:12px;overflow:auto} #bar{padding:8px 12px;background:#161b22;color:#c9d1d9;border-bottom:1px solid #30363d}
+ #s{width:220px} .meta{color:#8b949e;font-size:12px;margin-bottom:10px}
+</style></head><body>
+<div style="flex:1;display:flex;flex-direction:column">
+ <div id="bar"><b>handbook</b> &nbsp; <input id="s" placeholder="filter title/type…"></div>
+ <div id="g"></div>
+</div>
+<div id="p"><div class="meta">Klick auf einen Knoten.</div></div>
+<script>
+const D={"name": "handbook", "nodes": [{"id": "broken-yaml", "title": "broken-yaml", "type": "", "body": "\n\n# Broken\n\nBody of a page with broken frontmatter.\n"}, {"id": "getting-started", "title": "Getting started", "type": "Guide", "body": "\n\n# Getting started\n\n## Accounts\n\nAsk for an account. See the [glossary](/handbook/glossary.md) for terms.\n\n## Tools\n\nRead the [deploy runbook](ops/deploy.md) and the [security page](security.md).\nThe old tool is described in [retired tool](ops/retired-tool.md).\nDownload the [diagram](assets/diagram.svg). A [missing page](/handbook/ops/missing.md) is dead.\n\n### Wikilinks\n\nAlso see [[glossary]], [[deploy|the deploy page]] and [[does-not-exist]].\n\n## Next\n\nContinue with [[overview]].\n"}, {"id": "glossary", "title": "Glossary", "type": "Concept", "body": "\n\n# Glossary\n\n## Bundle\n\nA top-level directory of concepts.\n\n## Concept\n\nOne Markdown file with frontmatter.\n"}, {"id": "ops/deploy", "title": "Deploy", "type": "Runbook", "body": "\n\n# Deploy\n\n## Steps\n\n1. Run `deploy <env>` with the target.\n2. Wait for the `<env>.<region>` health check.\n3. Fetch `https://old-host.example.org/status`.\n\n## Links\n\nBack to [getting started](../getting-started.md).\nCompare [setup](setup.md) and the [rule](/kc-gov/ownership.md).\n"}, {"id": "ops/incident-2026", "title": "Incident 2026", "type": "Note", "body": "\n\n# Incident 2026\n\n## Timeline\n\nShort timeline.\n"}, {"id": "ops/retired-tool", "title": "Retired tool", "type": "Concept", "body": "\n\n# Retired tool\n\nReplaced by [deploy](deploy.md). See [[deploy]].\n"}, {"id": "ops/setup", "title": "Setup", "type": "Runbook", "body": "\n\n# Setup\n\nInstall the tools. Plain `old-host.example.org` is the old status host.\n\n<!-- okf:sync id=ownership-rule source=/kc-gov/ownership.md hash=594970cbf139 -->\n> [!quote] Synchronisiert aus `/kc-gov/ownership.md` \u2014 Canon-Owner, hier nicht bearbeiten.\n<!-- okf:sync-body -->\nEvery normative statement has exactly one owner.\n<!-- /okf:sync -->\n"}, {"id": "overview", "title": "Handbook overview", "type": "Concept", "body": "\n\n# Overview\n\nThe handbook explains the [getting started guide](getting-started.md).\n"}, {"id": "security", "title": "Security basics", "type": "Gadget", "body": "\n\n# Security basics\n\n## Passwords\n\nUse a password manager.\n\n## Reporting\n\nReport issues to the security team. Details in [[wiki-notes]].\n"}, {"id": "wiki-notes", "title": "wiki-notes", "type": "Note", "body": "\n\n# Wiki notes\n\n## Links\n\n- [[glossary]] resolves.\n- [[handbook/ops/deploy]] resolves by path.\n- [[retired-tool|old tool]] resolves with an alias.\n- [[glossary#Bundle]] resolves with a section.\n- [[overview]] is ambiguous (handbook and recipes).\n- [[nowhere]] is dead.\n- `[[in-code]]` is not a link.\n"}], "edges": [{"source": "getting-started", "target": "glossary"}, {"source": "getting-started", "target": "ops/deploy"}, {"source": "getting-started", "target": "security"}, {"source": "getting-started", "target": "ops/retired-tool"}, {"source": "ops/deploy", "target": "ops/setup"}, {"source": "ops/retired-tool", "target": "ops/deploy"}, {"source": "overview", "target": "getting-started"}]};
+const COL={ADR:'#f78166',Service:'#3fb950',Component:'#a371f7',Template:'#d29922',Reference:'#58a6ff',Guide:'#39c5cf',Concept:'#8b949e',Pattern:'#db61a2',SOP:'#e3b341',Playbook:'#ff7b72',LessonLearned:'#7ee787',ChangeNote:'#6e7681',Decision:'#bc8cff'};
+const cy=cytoscape({container:document.getElementById('g'),
+ elements:[...D.nodes.map(n=>({data:{id:n.id,label:n.title,type:n.type}})),
+           ...D.edges.map(e=>({data:{source:e.source,target:e.target}}))],
+ style:[{selector:'node',style:{'background-color':n=>COL[n.data('type')]||'#8b949e','width':10,'height':10,'label':'data(label)','font-size':6,'color':'#8b949e','min-zoomed-font-size':7}},
+        {selector:'edge',style:{'width':.6,'line-color':'#30363d','curve-style':'haystack','target-arrow-shape':'none'}},
+        {selector:'.hl',style:{'background-color':'#e6edf3','width':16,'height':16}}],
+ layout:{name:'cose',animate:false,nodeRepulsion:8000,idealEdgeLength:60}});
+const body=Object.fromEntries(D.nodes.map(n=>[n.id,n]));
+cy.on('tap','node',e=>{const n=body[e.target.id()];
+ document.getElementById('p').innerHTML='<div class="meta">'+n.type+' · '+e.target.id()+'</div><h1>'+n.title+'</h1>'+marked.parse(n.body||'');
+ cy.elements().removeClass('hl');e.target.addClass('hl');});
+document.getElementById('s').addEventListener('input',ev=>{const q=ev.target.value.toLowerCase();
+ cy.nodes().forEach(n=>{const h=!q||n.data('label').toLowerCase().includes(q)||(n.data('type')||'').toLowerCase().includes(q);n.style('display',h?'element':'none');});});
+</script></body></html>
